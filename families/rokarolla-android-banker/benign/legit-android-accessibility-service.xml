<!-- Legitimate Android accessibility service manifest fragment -->
<!-- Contains permission strings that overlap with banking trojans but
     should NOT trigger any Rokarolla rule -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.accessibility.helper">

    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <service
            android:name=".MyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
