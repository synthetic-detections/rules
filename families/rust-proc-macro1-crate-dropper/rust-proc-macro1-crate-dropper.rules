# rust-proc-macro1-crate-dropper.rules  (Suricata)
# ----------------------------------------------------------------------------
# Network C2 for the proc-macro1 crates.io build-script dropper (2026-08-20).
# A compromised crates.io account published arrayref@0.3.10 / internment@0.8.7 /
# append-only-vec@0.1.9, each adding a dependency on the typosquat proc-macro1,
# whose build.rs reassembled a bare-IP C2 from base64 and pulled an OS-specific
# infostealer over TLS with certificate validation disabled. The dropper
# connects by RAW IP (no name resolution for the payload host), so the IP rules
# are primary; the Hostwinds rDNS name is covered defensively via DNS + SNI.
#
#   Payload host : 23.254.165.112:9089 (TLS, AcceptAll verifier)
#   C2           : 23.254.165.112:443
#   Stage-2 C2   : 23.254.167.107 , 23.254.167.216
#   rDNS/host    : hwsrv-798836.hostwindsdns.com (Hostwinds VPS)
#
#   sid 9001301 -- egress to payload/C2 host 23.254.165.112
#   sid 9001302 -- egress to stage-2 C2 23.254.167.107 / 23.254.167.216
#   sid 9001303 -- DNS lookup of the Hostwinds C2 host (defensive)
#   sid 9001304 -- TLS SNI to the Hostwinds C2 host (defensive)
#
# Companion to the YARA rules in this dir (build.rs dropper + .crate IOC/hash).
# Sources: blog.rust-lang.org/2026/08/20/supply-chain-attack-on-arrayref,
# stepsecurity.io/blog/arrayref-rust-crate-supply-chain-attack. Related repo
# family: rust-proc-macro1-crate-dropper (this dir). IPs are Hostwinds
# (23.254.165.0/24, 23.254.167.0/24) — tighten/expire if the VPS is reassigned.
# ----------------------------------------------------------------------------
alert ip $HOME_NET any -> 23.254.165.112 any (msg:"PROC-MACRO1 DROPPER egress to payload/C2 host 23.254.165.112 (Hostwinds)"; reference:url,www.stepsecurity.io/blog/arrayref-rust-crate-supply-chain-attack; classtype:trojan-activity; sid:9001301; rev:1; metadata:author synthetic-detections, created_at 2026_08_20, severity critical, family rust-proc-macro1-crate-dropper;)
alert ip $HOME_NET any -> [23.254.167.107,23.254.167.216] any (msg:"PROC-MACRO1 DROPPER egress to stage-2 C2 23.254.167.107/216 (Hostwinds)"; reference:url,www.stepsecurity.io/blog/arrayref-rust-crate-supply-chain-attack; classtype:trojan-activity; sid:9001302; rev:1; metadata:author synthetic-detections, created_at 2026_08_20, severity high, family rust-proc-macro1-crate-dropper;)
alert dns $HOME_NET any -> any any (msg:"PROC-MACRO1 DROPPER DNS lookup of Hostwinds C2 host (hwsrv-798836.hostwindsdns.com)"; dns.query; content:"hwsrv-798836.hostwindsdns.com"; nocase; endswith; reference:url,www.stepsecurity.io/blog/arrayref-rust-crate-supply-chain-attack; classtype:trojan-activity; sid:9001303; rev:1; metadata:author synthetic-detections, created_at 2026_08_20, severity medium, family rust-proc-macro1-crate-dropper;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"PROC-MACRO1 DROPPER TLS SNI to Hostwinds C2 host (hwsrv-798836.hostwindsdns.com)"; tls.sni; content:"hwsrv-798836.hostwindsdns.com"; nocase; endswith; reference:url,www.stepsecurity.io/blog/arrayref-rust-crate-supply-chain-attack; classtype:trojan-activity; sid:9001304; rev:1; metadata:author synthetic-detections, created_at 2026_08_20, severity medium, family rust-proc-macro1-crate-dropper;)
