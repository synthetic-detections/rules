# arangodb-authbypass-taskrce-2026.rules  (Suricata)
# ----------------------------------------------------------------------------
# ArangoDB unauthenticated-to-root exploitation chain against internet-facing
# ArangoDB. Two GitHub advisories, 2026-09-06,
# affecting ArangoDB <= 3.12.10.1, fixed in 3.12.11 (CVEs pending):
#
#   Stage 1 — GHSA-rrgq-978q-36mq (CVSS 9.8): the auth gate reads the RAW url
#   while the router reads the DECODED url, so `/%5fapi/...` (%5f = "_") is
#   judged public but reaches the privileged `/_api/...` handler with no creds
#   (read/write/delete any collection, dump the root password hash). Patch
#   tests: /%5fapi/simple/remove-by-example, and encoded variants.
#
#   Stage 2 — GHSA-rvhw-4hpw-9vrx (CVSS 9.9): POST /_api/tasks with
#   `"isSystem": true` escapes the sandbox to internal god-mode; because the
#   official image runs as root, the task's JS can write a systemd unit / cron /
#   SSH key = root RCE + persistence.
#
# Rules match the RAW (undecoded) URI on purpose — normalising %5f back to "_"
# would defeat detection of the very bypass being attempted.
#   sid 2026091901 — Stage 1: %5f/%5F before an internal _-endpoint (raw uri)
#   sid 2026091902 — Stage 2: POST to (_)api/tasks with isSystem:true in body
#   sid 2026091903 — chained one-request %5f-bypass to task API + isSystem:true
# reference: https://remedio.io/blog/trust-me-im-the-system-arango-db-bugs-secure-system-architecture/
# ----------------------------------------------------------------------------

alert http any any -> any any ( \
    msg:"ARANGODB-EXPLOIT pre-auth _api URL-encoding auth bypass attempt (GHSA-rrgq-978q-36mq)"; \
    flow:to_server,established; \
    http.uri.raw; content:"%5"; nocase; \
    pcre:"/%5[fF](?:api|admin|db|system|users)/i"; \
    reference:url,remedio.io/blog/trust-me-im-the-system-arango-db-bugs-secure-system-architecture; \
    classtype:web-application-attack; \
    metadata:author synthetic-detections, date 2026-09-19, family arangodb-exploit, severity critical; \
    sid:2026091901; rev:2;)

alert http any any -> any any ( \
    msg:"ARANGODB-EXPLOIT system task privilege escalation (isSystem:true) - possible root RCE (GHSA-rvhw-4hpw-9vrx)"; \
    flow:to_server,established; \
    http.method; content:"POST"; \
    http.uri.raw; content:"api/tasks"; nocase; \
    http.request_body; content:"isSystem"; nocase; \
    pcre:"/\x22isSystem\x22\s*:\s*true/i"; \
    reference:url,remedio.io/blog/trust-me-im-the-system-arango-db-bugs-secure-system-architecture; \
    classtype:attempted-admin; \
    metadata:author synthetic-detections, date 2026-09-19, family arangodb-exploit, severity critical; \
    sid:2026091902; rev:2;)

alert http any any -> any any ( \
    msg:"ARANGODB-EXPLOIT chained unauth->root: %5f-bypass to task API with isSystem:true"; \
    flow:to_server,established; \
    http.method; content:"POST"; \
    http.uri.raw; content:"%5"; nocase; pcre:"/%5[fF]api\x2ftasks/i"; \
    http.request_body; content:"isSystem"; nocase; \
    pcre:"/\x22isSystem\x22\s*:\s*true/i"; \
    reference:url,remedio.io/blog/trust-me-im-the-system-arango-db-bugs-secure-system-architecture; \
    classtype:attempted-admin; \
    metadata:author synthetic-detections, date 2026-09-19, family arangodb-exploit, severity critical; \
    sid:2026091903; rev:2;)
