alert http any any -> $HOME_NET any (msg:"SYNTHDET ClingSTUN CVE-2025-67038 Lantronix EDS5000 rpc auth username command injection"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/cgi-bin/luci/rpc/auth"; http.request_body; content:"|24 28|"; sid:2026100624; rev:1; metadata:severity critical, family ClingSTUN, created_at 2026_10_06; classtype:attempted-admin; reference:cve,2025-67038;)
