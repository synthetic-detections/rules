# http2-bomb.rules
# ----------------------------------------------------------------------------
# Snort / Suricata rules for the HTTP/2 Bomb (Quang Luong / Codex, 2026-06-03;
# Apache httpd: CVE-2026-49975; nginx: fixed in 1.29.8 via `max_headers`).
#
# The Bomb chains three primitives. Two are detectable as raw byte content
# on the client→server side of an h2c TCP stream and are covered here:
#
#   sid 9000001 — SETTINGS_INITIAL_WINDOW_SIZE = 0  (the stall)
#   sid 9000002 — WINDOW_UPDATE  increment = 1, connection-level, one frame
#                 per TCP segment (Bomb "drip" tight-packet pattern)
#   sid 9000003 — WINDOW_UPDATE  increment = 1, any stream_id, one frame
#                 per TCP segment (Bomb "drip", PCRE variant)
#   sid 9000010 — Suricata-native: http2.frametype + http2.window for both
#                 batched and per-packet drips. Production rule.
#
# The third Bomb primitive — HPACK Indexed Reference Bomb (a HEADERS frame
# carrying thousands of 1-byte indexed references) — requires HPACK
# decoding to count amplification fan-out and is out of scope for a pure
# byte-content rule. Suricata's app-layer HTTP/2 parser already counts
# header-list size after decompression; pair this rule file with the
# built-in `app-layer-event:http2.invalid_header` family for the third leg.
#
# Scope: byte-content rules operate on TCP payload and therefore catch only
# h2c (cleartext HTTP/2). A real-world Bomb over TLS-encrypted h2 needs the
# rules applied at a TLS-terminating proxy / WAF that sees the decrypted
# stream — or, on Suricata, decryption via a configured keylog file.
#
# Detection-filter thresholds for sid 9000002/3/10 are intentionally low
# here (count 3 / 60 s) so the smoke-test PCAP fires reliably. Production
# tuning: count 50 / 5 s typically separates real Bomb traffic from any
# normal application that drips small WINDOW_UPDATEs.
#
# Why `dsize:13;` on the drip rules: Suricata defaults to stream-payload
# inspection, which dedups a repeating content to one match per flow.
# Adding the packet-payload-size pin forces per-packet inspection, which
# is what makes detection_filter's rate-counting work. The pin assumes
# each WINDOW_UPDATE frame arrives in its own TCP segment (the worst case
# for the engine, and the actual shape Codex's PoC produces). For batched
# drips packed into one segment, use sid 9000010 (HTTP/2-aware).
# ----------------------------------------------------------------------------

alert tcp any any -> any any ( \
    msg:"HTTP2-BOMB SETTINGS_INITIAL_WINDOW_SIZE=0 (Bomb stall primitive)"; \
    flow:to_server,established; \
    content:"|00 00 06 04 00 00 00 00 00 00 04 00 00 00 00|"; \
    reference:url,blog.calif.io/p/codex-discovered-a-hidden-http2-bomb; \
    reference:cve,2026-49975; \
    classtype:attempted-dos; \
    sid:9000001; rev:1;)

alert tcp any any -> any any ( \
    msg:"HTTP2-BOMB WINDOW_UPDATE increment=1 burst (connection-level, drip)"; \
    flow:to_server,established; \
    dsize:13; \
    content:"|00 00 04 08 00 00 00 00 00 00 00 00 01|"; depth:13; \
    detection_filter:track by_src, count 3, seconds 60; \
    reference:url,blog.calif.io/p/codex-discovered-a-hidden-http2-bomb; \
    classtype:attempted-dos; \
    sid:9000002; rev:2;)

alert tcp any any -> any any ( \
    msg:"HTTP2-BOMB WINDOW_UPDATE increment=1 burst (any stream_id, drip)"; \
    flow:to_server,established; \
    dsize:13; \
    content:"|00 00 04 08 00|"; depth:5; \
    pcre:"/^\x00\x00\x04\x08\x00.{4}\x00\x00\x00\x01$/"; \
    detection_filter:track by_src, count 3, seconds 60; \
    reference:url,blog.calif.io/p/codex-discovered-a-hidden-http2-bomb; \
    classtype:attempted-dos; \
    sid:9000003; rev:2;)

# Suricata-native (HTTP/2 app-layer aware): catches both batched and
# per-packet drips by parsing actual frames. Does not rely on dsize.
# Note: app-layer rules need Suricata's HTTP/2 parser enabled (default-on
# in 7.0). Not portable to Snort 2 / Snort 3 without HTTP/2 module.
alert http2 any any -> any any ( \
    msg:"HTTP2-BOMB WindowUpdate increment=1 burst (HTTP/2 frame-aware)"; \
    flow:to_server,established; \
    http2.frametype:WindowUpdate; \
    http2.window:1; \
    detection_filter:track by_src, count 3, seconds 60; \
    reference:url,blog.calif.io/p/codex-discovered-a-hidden-http2-bomb; \
    classtype:attempted-dos; \
    sid:9000010; rev:1;)
